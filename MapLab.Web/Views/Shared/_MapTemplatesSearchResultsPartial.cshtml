@using MapLab.Web.Models.Templates
@model IEnumerable<MapTemplateViewModel>

@if (!Model.Any())
{
    <p class="text-white-50">No map templates found for your search.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var template in Model)
        {
            <div class="col">
                <partial name="_MapTemplateCardPartial" model="@template" />
            </div>
        }
    </div>
}
