@using MapLab.Web.Models.Maps
@model EditMapViewModel

<div id="editMapModal" class="modal fade" tabindex="-1" aria-labelledby="editMapModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content bg-dark text-white border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 pb-2">
                <h2 class="modal-title fs-3 fw-bold" id="editMapModalLabel">Edit Map</h2>
                <button type="button" class="btn-close btn-close-white rounded-pill" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body px-4 overflow-auto">
                <div class="text-center mb-4">
                    <div class="step-icon-circle mx-auto mb-4">
                        <i class="bi bi-pencil-fill text-primary step-icon"></i>
                    </div>

                    <h3 class="fs-4 mb-3">Edit Your Map</h3>
                    <p class="text-white-50 mb-4">Edit your map's name and visibility</p>
                </div>

                <form method="post" id="editMapForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" id="editMapId" />

                    <div class="form-floating mb-4">
                        <input asp-for="Name" class="form-control bg-dark text-white border-secondary rounded-pill" id="mapNameInput" placeholder="Map Name">
                        <label for="mapNameInput" class="text-white-50">Map Name</label>
                    </div>
                    <span asp-validation-for="Name" class="text-danger small d-block mt-2"></span>

                    <div class="p-3 rounded-3 bg-dark bg-opacity-50 d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h4 class="fs-5 mb-1">Map Visibility</h4>
                            <p class="text-white-50 small mb-0">
                                Make your map visible to everyone
                            </p>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input rounded-pill" asp-for="IsPublic" type="checkbox" id="publicSwitch">
                            <label class="form-check-label" for="publicSwitch">
                                <i class="bi bi-info-circle ms-2" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Public maps are visible to other profiles and may be featured on the MapLab Community page. Private maps are accessible only via a shared link."></i>
                            </label>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer border-0 justify-content-center py-4">
                <button type="button" class="btn btn-outline-light px-4 rounded-pill" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="submit" form="editMapForm" class="btn btn-primary px-4 rounded-pill" id="finishBtn">
                    <i class="bi bi-floppy-fill me-2"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>
