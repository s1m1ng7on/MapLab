@using MapLab.Web.Models.Shared
@model PaginationViewModel
@{
    var currentQueryParams = new Dictionary<string, string>();
    var query = Context.Request.Query;

    foreach (var key in query.Keys)
    {
        if (!string.Equals(key, "page", StringComparison.OrdinalIgnoreCase))
        {
            currentQueryParams[key] = query[key].ToString() ?? "";
        }
    }
}

<nav aria-label="News pagination" class="mt-3">
    <ul class="pagination justify-content-center rounded-pill">
        @{
            if (Model.PageNumber != 1)
            {
                var routeFirst = new Dictionary<string, string?>(currentQueryParams) { ["page"] = "1" };
                <li class="page-item">
                    <a class="page-link" asp-all-route-data="routeFirst">1</a>
                </li>
            }

            if (Model.PageNumber > 3)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }

            if (Model.PageNumber > 2)
            {
                var routePrev = new Dictionary<string, string?>(currentQueryParams) { ["page"] = (Model.PageNumber - 1).ToString() };
                <li class="page-item">
                    <a class="page-link" asp-all-route-data="routePrev">@((Model.PageNumber - 1))</a>
                </li>
            }

            <li class="page-item active">
                <span class="page-link">@Model.PageNumber</span>
            </li>

            if (Model.PageNumber < Model.TotalPages - 1)
            {
                var routeNext = new Dictionary<string, string?>(currentQueryParams) { ["page"] = (Model.PageNumber + 1).ToString() };
                <li class="page-item">
                    <a class="page-link" asp-all-route-data="routeNext">@((Model.PageNumber + 1))</a>
                </li>
            }

            if (Model.PageNumber < Model.TotalPages - 2)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }

            if (Model.PageNumber != Model.TotalPages)
            {
                var routeLast = new Dictionary<string, string?>(currentQueryParams) { ["page"] = Model.TotalPages.ToString() };
                <li class="page-item">
                    <a class="page-link" asp-all-route-data="routeLast">@Model.TotalPages</a>
                </li>
            }
        }
    </ul>
</nav>
