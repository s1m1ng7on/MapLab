@using MapLab.Data.Models.Enums
@using MapLab.Web.Models.Maps
@using MapLab.Web.Models.Shared
@model MapsIndexViewModel
@{
    ViewData["Title"] = Model.IsCurrentProfile ? @_localizer["My Maps"] : @_localizer["Profile's Maps", Model.ProfileUserName];
    ViewData["UseViewportContainer"] = true;
}

@Html.AntiForgeryToken()
<div class="container py-5">
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h1 class="display-6 text-white mb-0 animate__animated animate__fadeIn">@ViewData["Title"]</h1>
        </div>
        <div class="col-md-6">
            <div class="d-flex justify-content-md-end mt-3 mt-md-0 animate__animated animate__fadeIn">
                <form method="get" id="filterForm" class="d-flex flex-wrap gap-2">
                    @if (!string.IsNullOrEmpty(Model.ProfileUserName))
                    {
                        <input type="hidden" name="profileUserName" value="@Model.ProfileUserName" />
                    }

                    <div class="input-group">
                        <select class="form-select rounded-pill" name="region" id="regionFilter" aria-label="Filter by region">
                            <option value="" selected="@(Model.Filters?.Region == null)">All Regions</option>
                            @foreach (var region in Enum.GetValues<Region>())
                            {
                                <option value="@region" selected="@(Model.Filters?.Region == region)">@region.ToString()</option>
                            }
                        </select>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.Maps == null || !Model.Maps.Any())
    {
        <div class="row h-100">
            <div class="col-12 d-flex align-items-center justify-content-center">
                <div class="text-center animate__animated animate__fadeIn">
                    <div class="mb-4">
                        <i class="bi bi-map-fill" style="font-size: 4rem; color: #6c757d;"></i>
                    </div>
                    <p class="lead">
                        @(Model.Filters != null
                            ? "No results match your selected filters. Try adjusting them or clearing all filters."
                            : Model.IsCurrentProfile
                                ? "You haven't created any maps yet. Click the + button to get started."
                                : "This profile hasn't created any maps yet.")
                    </p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var map in Model.Maps)
            {
                <div class="col animate__animated animate__fadeInUp">
                    <partial name="_MapCardPartial" model="@map" />
                </div>
            }
        </div>
    }
</div>

@if (Model.IsCurrentProfile)
{
    <button type="button"
            class="btn btn-primary floating-button floating"
            data-bs-toggle="modal"
            data-bs-target="#createMapModal">
        <i class="bi bi-plus-lg"></i>
    </button>
    <partial name="_CreateMapModalPartial" model="@Model.MapCreateViewModel" />
    <partial name="_EditMapModalPartial" model="new EditMapViewModel()"/>
    <partial name="_DeleteMapModalPartial" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/views/maps/index.css" asp-append-version="true" />
    <style>
        #filterForm .input-group {
            min-width: 170px;
        }

        #filterForm .form-select:focus,
        #filterForm .btn:focus {
            box-shadow: 0 0 0 0.25rem rgba(var(--bs-primary-rgb), 0.25);
        }

        .col.animate__fadeInUp {
            animation-duration: 0.5s;
        }

        @@media (max-width: 767.98px) {
            #filterForm {
                flex-wrap: wrap;
                justify-content: space-between;
            }

                #filterForm .input-group {
                    width: 100%;
                    margin-bottom: 0.5rem;
                }
        }
    </style>
}

@section Scripts {
    <script src="~/js/views/maps/index.js" asp-append-version="true"></script>
    <script src="~/js/mapCard.js" asp-append-version="true"></script>
    <script type="module" src="~/js/views/shared/_createMapModalPartial.js" asp-append-version="true"></script>
    <script src="~/js/components/search-bar.js" asp-append-version="true"></script>
}
