@using MapLab.Shared.Areas.Admin.Models
@using MapLab.Web.Areas.Admin.Models.Templates
@using MapLab.Web.Utilities
@using MapLab.Services.Models
@model TemplatesIndexViewModel
@{
    ViewData["Title"] = "Manage Templates";
}

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2>Manage Templates</h2>
                <a class="btn btn-primary rounded-pill"
                   asp-controller="Templates"
                   asp-action="Create">
                    <i class="bi bi-plus-lg me-2"></i>Create Template
                </a>
            </div>

            @if (Model.Items != null && Model.Items.Any())
            {
                <div class="d-flex flex-column">
                    <div class="table-responsive flex-grow-1" style="overflow-y: auto;">
                        <table class="table table-dark table-hover" style="table-layout: fixed;">
                            <thead class="sticky-top bg-dark">
                                <tr>
                                    <th style="width: 20%">Name</th>
                                    <th style="width: 15%">Region</th>
                                    <th style="width: 15%">Creator</th>
                                    <th style="width: 10%">Maps</th>
                                    <th style="width: 10%">Likes</th>
                                    <th style="width: 15%">Created On</th>
                                    <th style="width: 15%">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var template in Model.Items)
                                {
                                    <tr>
                                        <td class="text-truncate">@template.Name</td>
                                        <td>@template.Region</td>
                                        <td>
                                            <a class="text-white"
                                               asp-controller="Profile"
                                               asp-action="Index"
                                               asp-route-username="@template.ProfileUserName">
                                                <img class="profile-picture rounded-circle shadow-sm me-1"
                                                     src="@(template.ProfileProfilePictureFilePath ?? StaticFilePaths.DefaultProfilePicture)"
                                                     alt="@template.ProfileUserName" />
                                                @template.ProfileUserName
                                            </a>
                                        </td>
                                        <td>@template.MapsCount</td>
                                        <td>@template.LikesCount</td>
                                        <td><small class="text-muted">@template.CreatedOn.ToString("dd/MM/yyyy")</small></td>
                                        <td>
                                            <div class="action-btn-container">
                                                <a class="btn btn-primary btn-icon"
                                                   asp-controller="Templates"
                                                   asp-action="Details"
                                                   asp-route-id="@template.Id"
                                                   data-bs-toggle="tooltip"
                                                   title="View">
                                                    <i class="bi bi-eye-fill"></i>
                                                </a>
                                                <a class="btn btn-warning btn-icon"
                                                   asp-controller="Templates"
                                                   asp-action="Edit"
                                                   asp-route-id="@template.Id"
                                                   data-bs-toggle="tooltip"
                                                   title="Edit">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </a>
                                                <button class="btn btn-danger btn-icon"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-id="@template.Id"
                                                        title="Delete">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Templates pagination" class="mt-3">
                            <ul class="pagination justify-content-center rounded-pill">
                                @if (Model.PageNumber > 3)
                                {
                                    <li class="page-item"><a class="page-link" asp-route-page="1">1</a></li>
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }

                                @if (Model.PageNumber > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-route-page="@(Model.PageNumber - 1)">
                                            @(Model.PageNumber - 1)
                                        </a>
                                    </li>
                                }

                                <li class="page-item active">
                                    <span class="page-link">
                                        @Model.PageNumber
                                    </span>
                                </li>

                                @if (Model.PageNumber < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-route-page="@(Model.PageNumber + 1)">
                                            @(Model.PageNumber + 1)
                                        </a>
                                    </li>
                                }

                                @if (Model.PageNumber < Model.TotalPages - 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                    <li class="page-item">
                                        <a class="page-link" asp-route-page="@Model.TotalPages">@Model.TotalPages</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                </div>

                <!-- Delete Modal -->
                <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-dark text-white">
                            <div class="modal-header">
                                <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete this template?
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <form id="deleteForm" method="post" asp-controller="Templates" asp-action="Delete">
                                    <input type="hidden" id="deleteTemplateId" name="Id" />
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <style>
                    .table-responsive {
                        min-height: 200px;
                        border-radius: 0.5rem;
                        overflow: hidden;
                    }

                    .sticky-top {
                        position: sticky;
                        top: 0;
                        z-index: 100;
                    }

                    .action-btn-container {
                        display: flex;
                        gap: 0.25rem;
                    }

                    .btn-icon {
                        padding: 0.25rem 0.5rem;
                        line-height: 1;
                    }

                    .profile-picture {
                        width: 24px;
                        height: 24px;
                        object-fit: cover;
                    }
                </style>

                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        var deleteModal = document.getElementById('deleteModal');
                        deleteModal.addEventListener('show.bs.modal', function (event) {
                            var button = event.relatedTarget;
                            var templateId = button.getAttribute('data-id');
                            document.getElementById('deleteTemplateId').value = templateId;
                        });

                        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                        tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                            new bootstrap.Tooltip(tooltipTriggerEl);
                        });
                    });
                </script>
            }
            else
            {
                <div class="alert alert-secondary text-center" role="alert">
                    No templates available at the moment.
                    <div class="mt-3">
                        <a class="btn btn-success rounded-pill"
                           asp-controller="Templates"
                           asp-action="Create">
                            <i class="bi bi-plus-lg me-2"></i>Create Template
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
