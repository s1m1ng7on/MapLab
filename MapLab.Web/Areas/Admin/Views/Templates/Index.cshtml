@using MapLab.Shared.Areas.Admin.Models
@using MapLab.Web.Areas.Admin.Models.Templates
@using MapLab.Web.Models.Shared
@using MapLab.Web.Utilities
@using MapLab.Services.Models
@model TemplatesIndexViewModel
@{
    ViewData["Title"] = "Manage Templates";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage Templates</h2>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <form method="get" class="d-flex align-items-center gap-3 flex-wrap">
                <input type="hidden" name="page" value="@Model.PageNumber" />

                <!-- Date Filter Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle rounded-pill" type="button" id="dateFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-calendar-range me-1"></i> Date
                    </button>
                    <div class="dropdown-menu dropdown-menu-end mt-2 p-3 bg-dark text-light" style="min-width: 300px;">
                        <h6 class="dropdown-header">Quick Filters</h6>
                        <div class="d-grid gap-1">
                            <button type="submit" name="quickDateFilter" value="today" class="dropdown-item text-light">Today</button>
                            <button type="submit" name="quickDateFilter" value="last7days" class="dropdown-item text-light">Last 7 Days</button>
                            <button type="submit" name="quickDateFilter" value="thismonth" class="dropdown-item text-light">This Month</button>
                        </div>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header">Custom Range</h6>
                        <div class="mb-2">
                            <label asp-for="Filters.From" class="form-label small">From</label>
                            <input asp-for="Filters.From" type="date" class="form-control form-control-sm bg-dark text-light" id="startDate" value="@Model.Filters?.From?.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="mb-2">
                            <label asp-for="Filters.To" class="form-label small">To</label>
                            <input asp-for="Filters.To" type="date" class="form-control form-control-sm bg-dark text-light" id="endDate" value="@Model.Filters?.To?.ToString("yyyy-MM-dd")">
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm rounded-pill w-100 mt-2">Apply Filter</button>
                    </div>
                </div>

                <!-- Search Bar -->
                <div class="search-bar position-relative">
                    <input type="text" name="search" class="form-control rounded-pill" placeholder="Search by title or author..." value="@Model.Filters?.Search" />
                    <span class="position-absolute icon-container">
                        <i class="bi bi-search"></i>
                    </span>
                    <button type="button" class="clear-button position-absolute rounded-pill">×</button>
                </div>
            </form>
        </div>
        <a class="btn btn-primary rounded-pill"
           asp-controller="Templates"
           asp-action="Create">
            <i class="bi bi-plus-lg me-2"></i>Create Template
        </a>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="d-flex flex-column">
            <div class="table-responsive flex-grow-1" style="overflow-y: auto;">
                <table class="table table-dark table-hover" style="table-layout: fixed;">
                    <thead class="sticky-top bg-dark">
                        <tr>
                            <th style="width: 20%">Name</th>
                            <th style="width: 15%">Region</th>
                            <th style="width: 15%">Creator</th>
                            <th style="width: 10%">Maps</th>
                            <th style="width: 10%">Likes</th>
                            <th style="width: 15%">Created On</th>
                            <th style="width: 15%">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var template in Model.Items)
                        {
                            <tr>
                                <td class="text-truncate">
                                    <a class="text-white"
                                       asp-area=""
                                       asp-controller="Templates"
                                       asp-action="Info"
                                       asp-route-Id="@template.Id">
                                        @template.Name
                                    </a>
                                </td>
                                <td>@template.Region</td>
                                <td>
                                    <a class="text-white"
                                       asp-area=""
                                       asp-controller="Profile"
                                       asp-action="Index"
                                       asp-route-username="@template.ProfileUserName">
                                        <img class="profile-picture rounded-circle shadow-sm me-1"
                                             src="@(template.ProfileProfilePictureFilePath ?? StaticFilePaths.DefaultProfilePicture)"
                                             alt="@template.ProfileUserName" />@template.ProfileUserName
                                    </a>
                                </td>
                                <td>@template.MapsCount</td>
                                <td>@template.LikesCount</td>
                                <td><small class="text-muted">@template.CreatedOn.ToString("dd/MM/yyyy")</small></td>
                                <td>
                                    <div class="action-btn-container">
                                        <a class="btn btn-primary btn-icon"
                                           asp-area=""
                                           asp-controller="Templates"
                                           asp-action="Info"
                                           asp-route-id="@template.Id"
                                           data-bs-toggle="tooltip"
                                           title="View">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a class="btn btn-warning btn-icon"
                                           asp-controller="Templates"
                                           asp-action="Edit"
                                           asp-route-id="@template.Id"
                                           data-bs-toggle="tooltip"
                                           title="Edit">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <button class="btn btn-danger btn-icon btn-delete"
                                                data-id="@template.Id"
                                                data-name="@template.Name"
                                                title="Delete">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <partial name="_PaginationPartial" model="new PaginationViewModel() { PageNumber = Model.PageNumber, TotalPages = Model.TotalPages }" />

                @section Styles {
                <link rel="stylesheet" href="~/css/views/shared/_paginationPartial.css" asp-append-version="true" />
        }
            }
        </div>

        <partial name="_DeleteTemplateModalPartial" />

        <style>
            .table-responsive {
                min-height: 200px;
                border-radius: 0.5rem;
                overflow: hidden;
            }

            .sticky-top {
                position: sticky;
                top: 0;
                z-index: 100;
            }

            .action-btn-container {
                display: flex;
                gap: 0.25rem;
            }

            .btn-icon {
                padding: 0.25rem 0.5rem;
                line-height: 1;
            }

            .profile-picture {
                width: 24px;
                height: 24px;
                object-fit: cover;
            }
        </style>
    }
    else
    {
        <div class="row h-100">
            <div class="col-12 d-flex align-items-center justify-content-center">
                <div class="text-center animate__animated animate__fadeIn">
                    <div class="mb-4">
                        <i class="bi bi-info-circle-fill" style="font-size: 4rem; color: #6c757d;"></i>
                    </div>
                    <p class="lead">
                        @(
                            Model.Filters != null
                            ? "No items match your search or filters. Try adjusting them."
                            : "There's nothing to show here just yet. Add something to get started!"
                            )
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/areas/admin/views/templates/index.js" asp-append-version="true"></script>
    <script src="~/js/components/search-bar.js" asp-append-version="true"></script>
}