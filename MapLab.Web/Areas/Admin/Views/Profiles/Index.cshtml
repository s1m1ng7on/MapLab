@using MapLab.Web.Areas.Admin.Models.Profiles
@using MapLab.Web.Models.Shared
@model IndexViewModel

@{
    ViewData["Title"] = "Manage Profiles";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage Profiles</h2>
        <a class="btn btn-primary rounded-pill"
           asp-controller="Profiles"
           asp-action="Create">
            <i class="bi bi-plus-lg me-2"></i>Create Profile
        </a>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="d-flex flex-column">
            <div class="table-responsive flex-grow-1" style="overflow-y: auto;">
                <table class="table table-dark table-hover" style="table-layout: fixed;">
                    <thead class="sticky-top bg-dark">
                        <tr>
                            <th style="width: 20%;">UserName</th>
                            <th style="width: 25%;">Email</th>
                            <th style="width: 15%;">Phone</th>
                            <th style="width: 10%;">Maps</th>
                            <th style="width: 10%;">Templates</th>
                            <th style="width: 20%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var profile in Model.Items)
                        {
                            <tr>
                                <td class="text-truncate">@profile.UserName</td>
                                <td class="text-truncate">@profile.Email</td>
                                <td class="text-truncate">@profile.PhoneNumber</td>
                                <td>@profile.MapsCount</td>
                                <td>@profile.MapTemplatesCount</td>
                                <td>
                                    <div class="action-btn-container d-flex gap-2">
                                        <a class="btn btn-primary btn-icon"
                                           asp-controller="Profiles"
                                           asp-action="Details"
                                           asp-route-id="@profile.Id"
                                           title="View">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a class="btn btn-warning btn-icon"
                                           asp-controller="Profiles"
                                           asp-action="Edit"
                                           asp-route-id="@profile.Id"
                                           title="Edit">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <button class="btn btn-danger btn-icon btn-delete"
                                                data-id="@profile.Id"
                                                data-name="@profile.UserName"
                                                title="Delete">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <partial name="_PaginationPartial" model="new PaginationViewModel() { PageNumber = Model.PageNumber, TotalPages = Model.TotalPages }" />

                @section Styles {
                <link rel="stylesheet" href="~/css/views/shared/_paginationPartial.css" asp-append-version="true" />
        }
            }
        </div>
    }
    else
    {
        <div class="row h-100">
            <div class="col-12 d-flex align-items-center justify-content-center">
                <div class="text-center animate__animated animate__fadeIn">
                    <div class="mb-4">
                        <i class="bi bi-info-circle-fill" style="font-size: 4rem; color: #6c757d;"></i>
                    </div>
                    <p class="lead">
                        There's nothing to show here just yet. Add something to get started!
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/areas/admin/views/profiles/index.js" asp-append-version="true"></script>
}
