@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var isCollapsed = Context.Request.Cookies["sidebarCollapsed"] == "true";
    var sidebarClass = isCollapsed ? "sidebar-collapsed" : "";
}

<div class="sidebar bg-dark d-flex flex-column flex-shrink-0 p-0 h-100 position-relative @sidebarClass" id="sidebar">
    <div class="p-3 d-flex justify-content-between align-items-center">
        <span class="fs-4 text-light sidebar-title">Admin Panel</span>
        <button class="btn btn-toggle p-0 ms-2" id="sidebarToggle">
            <i class="bi bi-chevron-left text-light toggle-icon"></i>
        </button>
    </div>

    <hr class="m-0 border-secondary" />

    <div class="nav-section flex-grow-1 overflow-auto">
        <ul class="nav nav-pills flex-column mt-2">
            <li class="nav-item">
                <a class="nav-link @(currentArea == "Admin" && currentController == "Dashboard" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   data-bs-toggle="tooltip"
                   data-bs-placement="right"
                   title="Dashboard">
                    <i class="bi bi-house-door"></i>
                    <span class="nav-text">Home</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentArea == "Admin" && currentController == "Profiles" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Profiles"
                   asp-action="Index"
                   data-bs-toggle="tooltip"
                   data-bs-placement="right"
                   title="Profiles">
                    <i class="bi bi-people-fill"></i>
                    <span class="nav-text">Profiles</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentArea == "Admin" && currentController == "Maps" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Maps"
                   asp-action="Index"
                   data-bs-toggle="tooltip"
                   data-bs-placement="right"
                   title="Maps">
                    <i class="bi bi-map"></i>
                    <span class="nav-text">Maps</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentArea == "Admin" && currentController == "MapTemplates" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Templates"
                   asp-action="Index"
                   data-bs-toggle="tooltip"
                   data-bs-placement="right"
                   title="Templates">
                    <i class="bi bi-pin-map"></i>
                    <span class="nav-text">Templates</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentArea == "Admin" && currentController == "News" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="News"
                   asp-action="Index"
                   data-bs-toggle="tooltip"
                   data-bs-placement="right"
                   title="News">
                    <i class="bi bi-newspaper"></i>
                    <span class="nav-text">News</span>
                </a>
            </li>
        </ul>
    </div>

    <hr class="m-0 border-secondary" />

    <div class="bottom-section p-2">
        <ul class="nav nav-pills flex-column">
            <li class="nav-item">
                <a class="nav-link"
                   asp-area=""
                   asp-controller="Profile"
                   asp-action="Index"
                   data-bs-toggle="tooltip"
                   data-bs-placement="right"
                   title="My Profile">
                    <i class="bi bi-person"></i>
                    <span class="nav-text">My Profile</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link"
                   asp-area="Identity"
                   asp-page="/Account/Manage/Index"
                   data-bs-toggle="tooltip"
                   data-bs-placement="right"
                   title="Settings">
                    <i class="bi bi-gear"></i>
                    <span class="nav-text">Settings</span>
                </a>
            </li>
            <li class="nav-item mt-2">
                <a class="nav-link exit-link"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   data-bs-toggle="tooltip"
                   data-bs-placement="right"
                   title="Home">
                    <i class="bi bi-box-arrow-left"></i>
                    <span class="nav-text">Home</span>
                </a>
            </li>
        </ul>
    </div>
</div>

<script>
    $(document).ready(function () {
        const $sidebar = $('#sidebar');
        const $toggleBtn = $('#sidebarToggle');
        const $toggleIcon = $toggleBtn.find('.toggle-icon');

        function enableTooltips() {
            $sidebar.find('[data-bs-toggle="tooltip"]').tooltip();
        }

        function disableTooltips() {
            $sidebar.find('[data-bs-toggle="tooltip"]').tooltip('dispose');
        }

        // Initialize on load
        if ($sidebar.hasClass('sidebar-collapsed')) {
            $toggleIcon.removeClass('bi-chevron-left').addClass('bi-chevron-right');
            enableTooltips();
        }

        $toggleBtn.on('click', function () {
            $sidebar.toggleClass('sidebar-collapsed');
            const isCollapsed = $sidebar.hasClass('sidebar-collapsed');

            if (isCollapsed) {
                $toggleIcon.removeClass('bi-chevron-left').addClass('bi-chevron-right');
                document.cookie = "sidebarCollapsed=true; path=/";
                enableTooltips();
            } else {
                $toggleIcon.removeClass('bi-chevron-right').addClass('bi-chevron-left');
                document.cookie = "sidebarCollapsed=false; path=/";
                disableTooltips();
            }
        });
    });
</script>

<style>
    /* Sidebar basic styles */
    .sidebar {
        width: 250px;
        transition: all 0.3s ease;
    }

        /* Collapsed sidebar */
        .sidebar.sidebar-collapsed {
            width: 60px;
        }

            /* Hide text when collapsed */
            .sidebar.sidebar-collapsed .nav-text,
            .sidebar.sidebar-collapsed .sidebar-title {
                display: none;
            }

            /* Center icons when collapsed */
            .sidebar.sidebar-collapsed .nav-link {
                text-align: center;
                padding: 0.5rem;
            }

                .sidebar.sidebar-collapsed .nav-link i {
                    margin-right: 0 !important;
                    font-size: 1.2rem;
                }

        /* Improved navigation styles */
        .sidebar .nav-link {
            color: #adb5bd;
            border-radius: 0;
            padding: 0.5rem 1rem;
            margin: 0.2rem 0.5rem;
            display: flex;
            align-items: center;
            border-radius: 4px;
        }

            .sidebar .nav-link i {
                margin-right: 0.8rem;
                font-size: 1.1rem;
            }

            .sidebar .nav-link.active,
            .sidebar .nav-link:hover {
                color: white;
                background-color: rgba(73, 80, 87, 0.8);
            }

        /* Toggle button */
        .sidebar .btn-toggle {
            background: transparent;
            border: none;
            color: white;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            padding: 0;
            border-radius: 50%;
        }

            .sidebar .btn-toggle:hover {
                background-color: rgba(255, 255, 255, 0.1);
            }

        /* Sections */
        .sidebar .nav-section {
            overflow-y: auto;
        }

            /* Custom scrollbar for the nav section */
            .sidebar .nav-section::-webkit-scrollbar {
                width: 4px;
            }

            .sidebar .nav-section::-webkit-scrollbar-thumb {
                background-color: #495057;
                border-radius: 4px;
            }

        /* Exit link styling */
        .sidebar .exit-link {
            color: #dc3545;
            border: 1px solid rgba(220, 53, 69, 0.3);
        }

            .sidebar .exit-link:hover {
                background-color: rgba(220, 53, 69, 0.2);
                color: #fff;
            }

    /* Bottom section with fixed positioning */
    .bottom-section {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
</style>