@using MapLab.Web.Areas.Admin.Models.News
@using MapLab.Web.Models.Shared
@using MapLab.Web.Utilities
@model IndexViewModel
@{
    ViewData["Title"] = "Manage News";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage News</h2>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <form method="get" class="d-flex align-items-center gap-3 flex-wrap">
                <input type="hidden" name="page" value="@Model.PageNumber" />

                <!-- Date Filter Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle rounded-pill" type="button" id="dateFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-calendar-range me-1"></i> Date
                    </button>
                    <div class="dropdown-menu dropdown-menu-end mt-2 p-3 bg-dark text-light" style="min-width: 300px;">
                        <h6 class="dropdown-header">Quick Filters</h6>
                        <div class="d-grid gap-1">
                            <button type="submit" name="quickDateFilter" value="today" class="dropdown-item text-light">Today</button>
                            <button type="submit" name="quickDateFilter" value="last7days" class="dropdown-item text-light">Last 7 Days</button>
                            <button type="submit" name="quickDateFilter" value="thismonth" class="dropdown-item text-light">This Month</button>
                        </div>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header">Custom Range</h6>
                        <div class="mb-2">
                            <label for="startDate" class="form-label small">From</label>
                            <input type="date" class="form-control form-control-sm bg-dark text-light" id="startDate" name="from" value="@Model.Filters?.From?.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="mb-2">
                            <label for="endDate" class="form-label small">To</label>
                            <input type="date" class="form-control form-control-sm bg-dark text-light" id="endDate" name="to" value="@Model.Filters?.To?.ToString("yyyy-MM-dd")">
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm rounded-pill w-100 mt-2">Apply Filter</button>
                    </div>
                </div>

                <!-- Search Bar -->
                <div class="search-bar position-relative">
                    <input type="text" name="search" class="form-control rounded-pill" placeholder="Search by title or author..." value="@Model.Filters?.Search" />
                    <span class="position-absolute icon-container">
                        <i class="bi bi-search"></i>
                    </span>
                    <button type="button" class="clear-button position-absolute rounded-pill">×</button>
                </div>
            </form>

            <!-- Create Article Button -->
            <a class="btn btn-primary rounded-pill"
               asp-controller="News"
               asp-action="Create">
                <i class="bi bi-plus-lg me-2"></i>Create Article
            </a>
        </div>
    </div>
    @if (Model.Items!.Any())
    {
        <div class="d-flex flex-column">
            <div class="table-responsive flex-grow-1">
                <table class="table table-dark table-hover" style="table-layout: fixed;">
                    <thead class="sticky-top bg-dark">
                        <tr>
                            <th style="width: 40%">Title</th>
                            <th style="width: 20%">Author</th>
                            <th style="width: 20%" class="d-none d-md-table-cell">Created On</th>
                            <th style="width: 20%">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var newsArticle in Model.Items!)
                        {
                            <tr>
                                <td class="text-truncate">
                                    <a class="text-white"
                                       asp-area=""
                                       asp-controller="News"
                                       asp-action="Article"
                                       asp-route-Id="@newsArticle.Id">
                                        @newsArticle.Title
                                    </a>
                                </td>
                                <td>
                                    <a class="text-white"
                                       asp-area=""
                                       asp-controller="Profile"
                                       asp-action="Index"
                                       asp-route-username="@newsArticle.ProfileUserName">
                                        <img class="profile-picture rounded-circle shadow-sm me-1"
                                             src="@(newsArticle.ProfileProfilePictureFilePath ?? StaticFilePaths.DefaultProfilePicture)"
                                             alt="@newsArticle.ProfileUserName" />@newsArticle.ProfileUserName
                                    </a>
                                </td>
                                <td class="d-none d-md-table-cell">
                                    <small class="text-muted">
                                        @newsArticle.CreatedOn.ToString("dd/MM/yyyy")
                                    </small>
                                </td>
                                <td>
                                    <div class="action-btn-container">
                                        <a class="btn btn-primary btn-icon"
                                           asp-area=""
                                           asp-controller="News"
                                           asp-action="Article"
                                           asp-route-Id="@newsArticle.Id"
                                           data-bs-toggle="tooltip"
                                           title="View">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a class="btn btn-warning btn-icon"
                                           asp-controller="News"
                                           asp-action="Edit"
                                           asp-route-Id="@newsArticle.Id"
                                           data-bs-toggle="tooltip"
                                           title="Edit">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <button class="btn btn-danger btn-icon"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-id="@newsArticle.Id"
                                                data-bs-toggle="tooltip"
                                                title="Delete">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>


        @if (Model.TotalPages > 1)
        {
            <partial name="_PaginationPartial" model="new PaginationViewModel() { PageNumber = Model.PageNumber, TotalPages = Model.TotalPages }" />

            @section Styles {
                <link rel="stylesheet" href="~/css/views/shared/_paginationPartial.css" asp-append-version="true" />
            }
        }

        <!-- Pagination Styles -->
        <style>
            .table-responsive {
                height: 100%;
                border-radius: 0.5rem;
                overflow-y: auto;
            }

            .sticky-top {
                position: sticky;
                top: 0;
                z-index: 100;
            }

            /* Custom scrollbar for table */
            .table-responsive::-webkit-scrollbar {
                width: 8px;
            }

            .table-responsive::-webkit-scrollbar-track {
                background: var(--bs-dark-alt, #343a40);
            }

            .table-responsive::-webkit-scrollbar-thumb {
                background: var(--bs-primary, #0d6efd);
                border-radius: 4px;
            }

                .table-responsive::-webkit-scrollbar-thumb:hover {
                    background: var(--bs-primary-dark, #0a58ca);
                }

            /* Style for action buttons */
            .action-btn-container {
                display: flex;
                gap: 0.25rem;
            }

            .btn-icon {
                padding: 0.25rem 0.5rem;
                line-height: 1;
            }

            /* Make profile pictures consistent size */
            .profile-picture {
                width: 24px;
                height: 24px;
                object-fit: cover;
            }
        </style>


        <!-- Delete Confirmation Modal -->
        <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark text-white">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete this article?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <form id="deleteForm" method="post" asp-controller="News" asp-action="Delete">
                            <input type="hidden" id="deleteArticleId" name="Id" />
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Script to handle delete confirmation and initialize tooltips -->
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Handle delete modal
                var deleteModal = document.getElementById('deleteModal');
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var articleId = button.getAttribute('data-id');
                    document.getElementById('deleteArticleId').value = articleId;
                });

                // Initialize tooltips
                const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                    new bootstrap.Tooltip(tooltipTriggerEl);
                });
            });
        </script>
    }
    else
    {
        <div class="row h-100">
            <div class="col-12 d-flex align-items-center justify-content-center">
                <div class="text-center animate__animated animate__fadeIn">
                    <div class="mb-4">
                        <i class="bi bi-info-circle-fill" style="font-size: 4rem; color: #6c757d;"></i>
                    </div>
                    <p class="lead">
                        @(
                            Model.Filters != null
                            ? "No items match your search or filters. Try adjusting them."
                            : "There's nothing to show here just yet. Add something to get started!"
                            )
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/components/search-bar.js" asp-append-version="true"></script>
}