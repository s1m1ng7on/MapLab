@using MapLab.Common.Extensions
@using MapLab.Data.Models.Enums
@using MapLab.Shared.Areas.Admin.Models
@using MapLab.Web.Areas.Admin.Models.Maps
@using MapLab.Web.Models.Shared
@using MapLab.Web.Utilities
@using MapLab.Services.Models
@model IndexViewModel
@{
    ViewData["Title"] = "Manage Maps";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage Maps</h2>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <form method="get" class="d-flex align-items-center gap-3">
                <input type="hidden" name="page" value="@Model.PageNumber" />

                <!-- Views Filter Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle rounded-pill" type="button" id="viewsFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-eye me-1"></i> Views
                    </button>
                    <div class="dropdown-menu dropdown-menu-end mt-2 p-3 bg-dark text-light" style="min-width: 280px; max-width: 320px;">
                        <h6 class="dropdown-header">Views Range</h6>
                        <div class="d-flex flex-column gap-3">
                            <div>
                                <label for="viewsMin" class="form-label small">Min Views: <span id="viewsMinValue">@Model.Filters?.ViewsMin ?? 0</span></label>
                                <input type="range" min="0" max="10000" step="1" class="form-range" id="viewsMin" name="ViewsMin" value="@(Model.Filters?.ViewsMin ?? 0)"
                                       oninput="document.getElementById('viewsMinValue').innerText = this.value" />
                            </div>
                            <div>
                                <label for="viewsMax" class="form-label small">Max Views: <span id="viewsMaxValue">@Model.Filters?.ViewsMax ?? 10000</span></label>
                                <input type="range" min="0" max="10000" step="1" class="form-range" id="viewsMax" name="ViewsMax" value="@(Model.Filters?.ViewsMax ?? 10000)"
                                       oninput="document.getElementById('viewsMaxValue').innerText = this.value" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm rounded-pill w-100 mt-3">Apply Views Filter</button>
                    </div>
                </div>

                <!-- Likes Filter Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle rounded-pill" type="button" id="likesFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-hand-thumbs-up me-1"></i> Likes
                    </button>
                    <div class="dropdown-menu dropdown-menu-end mt-2 p-3 bg-dark text-light" style="min-width: 280px; max-width: 320px;">
                        <h6 class="dropdown-header">Likes Range</h6>
                        <div class="d-flex flex-column gap-3">
                            <div>
                                <label for="likesMin" class="form-label small">Min Likes: <span id="likesMinValue">@Model.Filters?.LikesMin ?? 0</span></label>
                                <input type="range" min="0" max="5000" step="1" class="form-range" id="likesMin" name="LikesMin" value="@(Model.Filters?.LikesMin ?? 0)"
                                       oninput="document.getElementById('likesMinValue').innerText = this.value" />
                            </div>
                            <div>
                                <label for="likesMax" class="form-label small">Max Likes: <span id="likesMaxValue">@Model.Filters?.LikesMax ?? 5000</span></label>
                                <input type="range" min="0" max="5000" step="1" class="form-range" id="likesMax" name="LikesMax" value="@(Model.Filters?.LikesMax ?? 5000)"
                                       oninput="document.getElementById('likesMaxValue').innerText = this.value" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm rounded-pill w-100 mt-3">Apply Likes Filter</button>
                    </div>
                </div>

                <!-- Date Filter Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle rounded-pill" type="button" id="dateFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-calendar-range me-1"></i> Date & Filters
                    </button>
                    <div class="dropdown-menu dropdown-menu-end mt-2 p-3 bg-dark text-light" style="min-width: 320px; max-width: 400px;">
                        <h6 class="dropdown-header">Quick Filters</h6>
                        <div class="d-grid gap-1 mb-3">
                            <button type="submit" name="quickDateFilter" value="today" class="dropdown-item text-light">Today</button>
                            <button type="submit" name="quickDateFilter" value="last7days" class="dropdown-item text-light">Last 7 Days</button>
                            <button type="submit" name="quickDateFilter" value="thismonth" class="dropdown-item text-light">This Month</button>
                        </div>

                        <div class="dropdown-divider"></div>

                        <h6 class="dropdown-header">Custom Date Range</h6>
                        <div class="mb-3">
                            <label class="form-label small" for="startDate">From</label>
                            <input asp-for="Filters.From" type="date" class="form-control form-control-sm bg-dark text-light" id="startDate"
                                   name="From" value="@(Model.Filters?.From.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small" for="endDate">To</label>
                            <input asp-for="Filters.To" type="date" class="form-control form-control-sm bg-dark text-light" id="endDate"
                                   name="To" value="@(Model.Filters?.To.ToString("yyyy-MM-dd"))" />
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm rounded-pill w-100 mt-2">Apply Filter</button>
                    </div>
                </div>

                <div class="input-group">
                    <select class="form-select rounded-pill" name="region" id="regionFilter" aria-label="Filter by region">
                        <option value="" selected="@(Model.Filters?.Region == null)">All Regions</option>
                        @foreach (var region in Enum.GetValues<Region>())
                        {
                            <option value="@region" selected="@(Model.Filters?.Region == region)">@region.ToString()</option>
                        }
                    </select>
                </div>

                <!-- Search Bar -->
                <div class="search-bar position-relative">
                    <input type="text" name="Search" class="form-control rounded-pill" placeholder="Search by name, template or creator..." value="@Model.Filters?.Search" />
                    <span class="position-absolute icon-container">
                        <i class="bi bi-search"></i>
                    </span>
                    <button type="button" class="clear-button position-absolute rounded-pill">×</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="d-flex flex-column">
            <div class="table-responsive flex-grow-1" style="overflow-y: auto;">
                <table class="table table-dark table-hover" style="table-layout: fixed;">
                    <thead class="sticky-top bg-dark">
                        <tr>
                            <th style="width: 20%">Name</th>
                            <th style="width: 10%">Template</th>
                            <th style="width: 15%">Region</th>
                            <th style="width: 15%">Creator</th>
                            <th style="width: 10%">Likes</th>
                            <th style="width: 10%">Views</th>
                            <th style="width: 10%">Created On</th>
                            <th style="width: 10%">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var map in Model.Items)
                        {
                            <tr>
                                <td class="text-truncate">
                                    <a class="text-white d-flex gap-2"
                                       asp-area=""
                                       asp-controller="Maps"
                                       asp-action="Info"
                                       asp-route-Id="@map.Id">
                                        @map.Name
                                        @if (!map.IsPublic)
                                        {
                                            <span class="badge rounded-pill bg-primary bg-opacity-75 d-flex align-items-center">
                                                <i class="bi bi-lock-fill"></i>
                                            </span>
                                        }
                                    </a>
                                </td>
                                <td class="text-truncate">
                                    <span class="badge bg-secondary bg-opacity-25 rounded-pill px-2 py-1">
                                        <a asp-controller="Templates"
                                           asp-action="Info"
                                           asp-route-Id="@map.MapTemplateId"
                                           class="text-light text-decoration-none">
                                            <i class="bi bi-grid me-1"></i>@map.MapTemplateName
                                        </a>
                                    </span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-primary bg-opacity-75">
                                        <i class="bi bi-globe-europe-africa me-1"></i>@map.MapTemplateRegion?.GetDisplayName()
                                    </span>
                                </td>
                                <td>
                                    <a class="text-white"
                                       asp-area=""
                                       asp-controller="Profile"
                                       asp-action="Index"
                                       asp-route-username="@map.ProfileUserName">
                                        <img class="profile-picture rounded-circle shadow-sm me-1"
                                             src="@(map.ProfileProfilePictureFilePath ?? StaticFilePaths.DefaultProfilePicture)"
                                             alt="@map.ProfileUserName" />@map.ProfileUserName
                                    </a>
                                </td>
                                <td>@map.LikesCount</td>
                                <td>@map.ViewsCount</td>
                                <td><small class="text-muted">@map.CreatedOn.ToString("dd/MM/yyyy")</small></td>
                                <td>
                                    <div class="action-btn-container">
                                        <button class="btn btn-danger btn-icon btn-delete"
                                                data-id="@map.Id"
                                                data-name="@map.Name"
                                                title="Delete">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <partial name="_PaginationPartial" model="new PaginationViewModel() { PageNumber = Model.PageNumber, TotalPages = Model.TotalPages }" />

                @section Styles {
                <link rel="stylesheet" href="~/css/views/shared/_paginationPartial.css" asp-append-version="true" />
        }
            }
        </div>

        <partial name="_DeleteMapModalPartial" model="new DeleteMapModalPartialViewModel() { IsAdmin = true }"/>

        <style>
            .table-responsive {
                min-height: 200px;
                border-radius: 0.5rem;
                overflow: hidden;
            }

            .sticky-top {
                position: sticky;
                top: 0;
                z-index: 100;
            }

            .action-btn-container {
                display: flex;
                gap: 0.25rem;
            }

            .btn-icon {
                padding: 0.25rem 0.5rem;
                line-height: 1;
            }

            .profile-picture {
                width: 24px;
                height: 24px;
                object-fit: cover;
            }
        </style>
    }
    else
    {
        <div class="row h-100">
            <div class="col-12 d-flex align-items-center justify-content-center">
                <div class="text-center animate__animated animate__fadeIn">
                    <div class="mb-4">
                        <i class="bi bi-info-circle-fill" style="font-size: 4rem; color: #6c757d;"></i>
                    </div>
                    <p class="lead">
                        @(
                            Model.Filters != null
                            ? "No maps match your search or filters. Try adjusting them."
                            : "There's nothing to show here just yet. Add something to get started!"
                            )
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/areas/admin/views/maps/index.js" asp-append-version="true"></script>
    <script src="~/js/components/search-bar.js" asp-append-version="true"></script>
}
